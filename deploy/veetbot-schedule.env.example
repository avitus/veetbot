# Copy to /etc/veetbot/veetbot-schedule.env and replace every REQUIRED value.
# This file is deliberately independent from veetbot.env: do not add API bearer
# tokens, model-provider keys, web-provider keys, or browser-profile credentials.
DATABASE_URL=postgresql+asyncpg://veetbot_schedule:REQUIRED_DATABASE_PASSWORD@127.0.0.1:REQUIRED_FREE_LOOPBACK_PORT/agent
PGSSLMODE=disable
DEPLOYMENT_MODE=production
AUTH_MODE=token
AUTH_TENANT_ID=REQUIRED_TENANT_ID
AUTH_PRINCIPAL_ID=REQUIRED_PRINCIPAL_ID
AUTH_ROLES=user
AUTH_SCOPES=session.read,schedule.read,schedule.write,schedule.cancel
AGENT_SCHEDULE_API_ENABLED=1
AGENT_SCHEDULE_WORKER_ENABLED=1
# Mirror application Gmail activation so the current-authority check sees the
# same account roster. The scheduler reads only non-secret manifest metadata;
# it never opens the referenced OAuth credential files. In legacy single-account
# mode set AGENT_EMAIL_ENABLED=1 and leave GMAIL_ACCOUNTS_FILE empty. Never add
# GMAIL_READ_CREDENTIAL_FILE, GMAIL_WRITE_CREDENTIAL_FILE, or
# GMAIL_SEND_CREDENTIAL_FILE to this role.
AGENT_EMAIL_ENABLED=0
GMAIL_ACCOUNTS_FILE=
# Keep both notification flags equal to the application environment. The
# schedule role needs them to write schedule outcome notifications but never
# receives the APNs credential, which remains confined to the notify role.
AGENT_NOTIFICATION_API_ENABLED=0
AGENT_NOTIFICATION_DISPATCH_ENABLED=0
AGENT_CONFIG_DIR=
