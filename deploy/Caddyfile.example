# Replace agent.example.com before installing this file as /etc/caddy/Caddyfile.
agent.example.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	reverse_proxy 127.0.0.1:8000 {
		# Flush SSE events immediately rather than buffering the stream.
		flush_interval -1
	}
}
