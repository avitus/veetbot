# Use the dedicated database role described in docs/bland-setup.md.
# No owner API bearer, model, email, browser, or other tool credentials.
DATABASE_URL=postgresql+asyncpg://veetbot_call_ingress:REQUIRED_DATABASE_PASSWORD@127.0.0.1:REQUIRED_FREE_LOOPBACK_PORT/agent
DEPLOYMENT_MODE=production
AUTH_MODE=token
AUTH_TENANT_ID=REQUIRED_TENANT_ID
AUTH_PRINCIPAL_ID=REQUIRED_PRINCIPAL_ID
AUTH_ROLES=calling
# Calling roles act for the owner principal without any of its scopes.
AUTH_SCOPES=
AGENT_CALL_ENABLED=0
AGENT_CALL_INGRESS_ENABLED=0
AGENT_CALL_NOTIFICATIONS_ENABLED=0
AGENT_NOTIFICATION_API_ENABLED=0
BLAND_CONFIGURATION_FILE=
# Once enabled, use /etc/veetbot/bland-configuration.json and uncomment:
# BLAND_WEBHOOK_SECRET_FILE=/etc/veetbot-call-ingress/bland-webhook-secret
