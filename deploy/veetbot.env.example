# Copy to /etc/veetbot/veetbot.env and replace every REQUIRED value.
# POSTGRES_PASSWORD and the password embedded in DATABASE_URL must match.
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=REQUIRED_DATABASE_PASSWORD
POSTGRES_PORT=REQUIRED_FREE_LOOPBACK_PORT
# Keep the Compose project stable across immutable release directories. If a
# pre-existing deployment used another project name, put that exact name here.
COMPOSE_PROJECT_NAME=veetbot
DATABASE_URL=postgresql+asyncpg://agent:REQUIRED_DATABASE_PASSWORD@127.0.0.1:REQUIRED_FREE_LOOPBACK_PORT/agent
# PostgreSQL is loopback-only on the single-Droplet topology. Disabling TLS also
# prevents asyncpg from probing ~/.postgresql inside ProtectHome=true services.
PGSSLMODE=disable
DEPLOYMENT_MODE=production
# Written per release by deploy/app/release.sh. Do not set it in this shared file.

AUTH_MODE=token
AUTH_TOKEN=REQUIRED_RANDOM_TOKEN
AUTH_TENANT_ID=REQUIRED_TENANT_ID
AUTH_PRINCIPAL_ID=REQUIRED_PRINCIPAL_ID
AUTH_ROLES=user
AUTH_SCOPES=session.read,session.write,run.read,run.write,run.cancel,approval.read,approval.resolve,artifact.read,artifact.write,workspace.read,workspace.write,sandbox.execute,skill.write,knowledge.write

SANDBOX_MECHANISM=gvisor
AGENT_SANDBOX_IMAGE=agent-core-sandbox:production
AGENT_SANDBOX_PASSTHROUGH=

AGENT_ARTIFACT_ROOT=/var/lib/veetbot/artifacts
AGENT_TRAJECTORY_EXPORT_ENABLED=0
AGENT_CONFIG_DIR=

# Production sessions use the declared `balanced` policy by default. In the
# shipped model policy that selects OpenAI, so VEETBOT_OPENAI_KEY is required
# unless a reviewed AGENT_CONFIG_DIR overlay retargets `balanced`.
VEETBOT_OPENAI_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=

# Public-web tools are absent until the corresponding selector is enabled.
# Recommended production split: tavily search and firecrawl fetch.
WEB_SEARCH_PROVIDER=disabled
WEB_FETCH_PROVIDER=disabled
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
