# Copy to /etc/veetbot/veetbot.env and replace every REQUIRED value.
# POSTGRES_PASSWORD and the password embedded in DATABASE_URL must match.
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=REQUIRED_DATABASE_PASSWORD
POSTGRES_PORT=REQUIRED_FREE_LOOPBACK_PORT
# Keep the Compose project stable across immutable release directories. If a
# pre-existing deployment used another project name, put that exact name here.
COMPOSE_PROJECT_NAME=veetbot
DATABASE_URL=postgresql+asyncpg://agent:REQUIRED_DATABASE_PASSWORD@127.0.0.1:REQUIRED_FREE_LOOPBACK_PORT/agent
# PostgreSQL is loopback-only on the single-Droplet topology. Disabling TLS also
# prevents asyncpg from probing ~/.postgresql inside ProtectHome=true services.
PGSSLMODE=disable
DEPLOYMENT_MODE=production
# Written per release by deploy/app/release.sh. Do not set it in this shared file.

AUTH_MODE=token
AUTH_TOKEN=REQUIRED_RANDOM_TOKEN
AUTH_TENANT_ID=REQUIRED_TENANT_ID
AUTH_PRINCIPAL_ID=REQUIRED_PRINCIPAL_ID
AUTH_ROLES=user
AUTH_SCOPES=session.read,session.write,run.read,run.write,run.cancel,approval.read,approval.resolve,artifact.read,artifact.write,workspace.read,workspace.write,sandbox.execute,skill.write,knowledge.write,browser.profile.read,browser.profile.write,browser.grant.read,browser.grant.write,schedule.read,schedule.write,schedule.cancel

SANDBOX_MECHANISM=gvisor
AGENT_SANDBOX_IMAGE=agent-core-sandbox:production
AGENT_SANDBOX_PASSTHROUGH=
AGENT_EXECUTION_SERVICE_SOCKET=/run/veetbot/execution.sock

AGENT_ARTIFACT_ROOT=/var/lib/veetbot/artifacts
AGENT_TRAJECTORY_EXPORT_ENABLED=0
AGENT_SCHEDULE_API_ENABLED=0
AGENT_SCHEDULE_WORKER_ENABLED=0
AGENT_CONFIG_DIR=

# Production sessions use the declared `balanced` policy by default. In the
# shipped model policy that selects OpenAI, so VEETBOT_OPENAI_KEY is required
# unless a reviewed AGENT_CONFIG_DIR overlay retargets `balanced`.
VEETBOT_OPENAI_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=

# Public-web tools are absent until the corresponding selector is enabled.
# Recommended production split: tavily search and firecrawl fetch.
WEB_SEARCH_PROVIDER=disabled
WEB_FETCH_PROVIDER=disabled
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Rendered-browser tools remain absent until BROWSER_PROVIDER is explicitly
# selected. Hosted mode additionally requires one trusted profile UUID.
BROWSER_PROVIDER=disabled
BROWSER_ALLOWED_ORIGINS=
BROWSER_PROFILE_ID=
BROWSER_GRANT_ID=
BROWSER_RUN_PURPOSE=

# The public HTTPS reverse proxy terminates at the loopback-only profile
# service port. The orchestration client reads its credential from a private
# file; secret bytes never appear in this environment file.
#
# The control-plane credential and the service auth file carry the SAME token
# but remain separate root-managed inputs. systemd LoadCredential gives each
# application unit a private copy without putting its path or bytes here.
BROWSER_PROFILE_SERVICE_URL=https://browser.veetbot.com
BROWSER_PROFILE_CEREMONY_BASE_URL=https://browser.veetbot.com
BROWSER_PROFILE_PORT=8081

# Browser-profile service secret mounts, read inside the container. Provision
# all three paths as uid/gid 65532; the directory must be 0700 and files 0600.
# The auth file contains one opaque token (the same value as the control-plane
# credential above). The key directory contains `current` plus base64-encoded
# 32-byte `<version>.key` files; the service does not generate keys because
# its mount is read-only. Never put a secret value directly in this file.
BROWSER_PROFILE_SERVICE_AUTH_FILE=/etc/veetbot/secrets/browser-profile-service-auth
BROWSER_PROFILE_SESSION_SECRET_FILE=/etc/veetbot/secrets/browser-profile-session-secret
BROWSER_PROFILE_KEY_DIR=/etc/veetbot/secrets/browser-profile-keys
