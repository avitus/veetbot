# Copy to /etc/veetbot/veetbot.env and replace every REQUIRED value.
# POSTGRES_PASSWORD and the password embedded in DATABASE_URL must match.
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=REQUIRED_DATABASE_PASSWORD
POSTGRES_PORT=REQUIRED_FREE_LOOPBACK_PORT
# Keep the Compose project stable across immutable release directories. If a
# pre-existing deployment used another project name, put that exact name here.
COMPOSE_PROJECT_NAME=veetbot
DATABASE_URL=postgresql+asyncpg://agent:REQUIRED_DATABASE_PASSWORD@127.0.0.1:REQUIRED_FREE_LOOPBACK_PORT/agent
# PostgreSQL is loopback-only on the single-Droplet topology. Disabling TLS also
# prevents asyncpg from probing ~/.postgresql inside ProtectHome=true services.
PGSSLMODE=disable
DEPLOYMENT_MODE=production
# Written per release by deploy/app/release.sh. Do not set it in this shared file.

AUTH_MODE=token
AUTH_TOKEN=REQUIRED_RANDOM_TOKEN
AUTH_TENANT_ID=REQUIRED_TENANT_ID
AUTH_PRINCIPAL_ID=REQUIRED_PRINCIPAL_ID
AUTH_ROLES=user
AUTH_SCOPES=session.read,session.write,run.read,run.write,run.cancel,approval.read,approval.resolve,artifact.read,artifact.write,workspace.read,workspace.write,sandbox.execute,skill.write,knowledge.write,browser.profile.read,browser.profile.write,browser.grant.read,browser.grant.write,schedule.read,schedule.write,schedule.cancel,device.read,device.write,notification.read,memory.read,memory.write,people.read,people.write,settings.read,settings.write

SANDBOX_MECHANISM=gvisor
AGENT_SANDBOX_IMAGE=agent-core-sandbox:production
AGENT_SANDBOX_PASSTHROUGH=
AGENT_EXECUTION_SERVICE_SOCKET=/run/veetbot/execution.sock

AGENT_ARTIFACT_ROOT=/var/lib/veetbot/artifacts
AGENT_TRAJECTORY_EXPORT_ENABLED=0
AGENT_SCHEDULE_API_ENABLED=0
AGENT_SCHEDULE_WORKER_ENABLED=0
AGENT_NOTIFICATION_API_ENABLED=0
AGENT_NOTIFICATION_DISPATCH_ENABLED=0
AGENT_SURFACE_API_ENABLED=0
AGENT_SURFACE_WORKER_ENABLED=0
AGENT_SURFACE_WHATSAPP_ENABLED=0
AGENT_MEMORY_API_ENABLED=0
# People is available by default; set zero only for operational shutdown.
AGENT_PEOPLE_ENABLED=1
AGENT_PERSONA_API_ENABLED=0
# Milestone 29 chat thread folders; grants no authority beyond session scopes.
AGENT_THREAD_FOLDERS_API_ENABLED=0
# ADR-0120 chat attachments: the 32 MiB upload route under artifact.write.
# Owner-sent text, Markdown, and PDF files also reach knowledge when the owner
# holds knowledge.write. Deploy the Nginx upload location with it.
AGENT_ATTACHMENT_UPLOADS_ENABLED=0
AGENT_EMAIL_ENABLED=0
# Milestone 26 client Email experience; requires the existing Gmail accounts.
# Automatic email defaults: USD 20/day UTC and USD 200/rolling 30 days.
# Reviewed AGENT_CONFIG_DIR/runtime/limits.yaml can override email.daily_cost
# and email.monthly_cost with finite, owner-authorized dollar allowances.
# When activating, add email.read,email.write to AUTH_SCOPES alongside the
# existing exact account-specific MCP scopes; this flag grants no authority.
AGENT_EMAIL_MODE_ENABLED=0
# Bulk-sender census and owner-consented unsubscribe (Milestone 31). Requires both
# flags above. It sends an RFC 8058 one-click request, only on the owner's tap or
# approval, through a dedicated public-HTTPS egress transport; senders see this
# host's address. It grants no authority and needs no new Google permission.
AGENT_EMAIL_UNSUBSCRIBE_ENABLED=0
# Optional legacy semantic evidence; People uses email-semantic@2 without an artifact.
AGENT_EMAIL_SEMANTIC_EVIDENCE=
# Set either all three legacy paths or GMAIL_ACCOUNTS_FILE when
# AGENT_EMAIL_ENABLED=1. The accounts manifest contains paths, never OAuth
# material; every referenced credential JSON remains root-provisioned 0600.
GMAIL_READ_CREDENTIAL_FILE=
GMAIL_WRITE_CREDENTIAL_FILE=
GMAIL_SEND_CREDENTIAL_FILE=
GMAIL_ACCOUNTS_FILE=
PUSH_PROVIDER=disabled
AGENT_CONFIG_DIR=

# New production sessions use the declared `astra` policy by default. In the
# shipped model policy that selects OpenAI, so VEETBOT_OPENAI_KEY is required
# unless a reviewed AGENT_CONFIG_DIR overlay retargets `astra`.
# Memory formation independently uses `balanced` (GPT-5.6 Sol) for now;
# formation.model_policy in memory/profiles.yaml records that temporary choice.
VEETBOT_OPENAI_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=

# Public-web tools are absent until the corresponding selector is enabled.
# Plural selectors accept provider:percentage entries summing to 100. Leave
# them empty to use the backward-compatible single-provider selectors below.
WEB_SEARCH_PROVIDER=disabled
WEB_FETCH_PROVIDER=disabled
WEB_SEARCH_PROVIDERS=
WEB_FETCH_PROVIDERS=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
KEENABLE_API_KEY=

# The typed-judgment provider (ADR-0110) stays off until JUDGMENT_PROVIDER names
# one; TYPESAFE_API_KEY alone enables nothing. Keep both out of the schedule
# and notify environment files: those workers refuse to start with a provider key.
JUDGMENT_PROVIDER=disabled
TYPESAFE_API_KEY=

# Observe-only policy advisory layer (ADR-0111). With a judgment provider composed,
# setting this to 1 makes the policy engine consult the advisor on allowed web
# searches, fetches and navigations and record its verdict; no decision changes
# and policy_version does not move.
# Enforcing is a policy-profile value (advisory.enabled), not an environment flag.
AGENT_POLICY_ADVISORY_OBSERVE_ENABLED=0

# Rendered-browser tools remain absent until BROWSER_PROVIDER is explicitly
# selected. Hosted mode can resolve a principal-selected READY profile from each
# session. Set BROWSER_PROFILE_ID and BROWSER_ALLOWED_ORIGINS together only for
# a deployment-wide pin (required for a configured standing grant).
BROWSER_PROVIDER=disabled
BROWSER_ALLOWED_ORIGINS=
BROWSER_PROFILE_ID=
BROWSER_GRANT_ID=
BROWSER_RUN_PURPOSE=

# The public HTTPS reverse proxy terminates at the loopback-only profile
# service port. The orchestration client reads its credential from a private
# file; secret bytes never appear in this environment file.
#
# The control-plane credential and the service auth file carry the SAME token
# but remain separate root-managed inputs. systemd LoadCredential gives each
# application unit a private copy without putting its path or bytes here.
BROWSER_PROFILE_SERVICE_URL=https://browser.veetbot.com
BROWSER_PROFILE_CEREMONY_BASE_URL=https://browser.veetbot.com
BROWSER_PROFILE_PORT=8081

# Browser-profile service secret mounts, read inside the container. Provision
# all three paths as uid/gid 65532; the directory must be 0700 and files 0600.
# The auth file contains one opaque token (the same value as the control-plane
# credential above). The key directory contains `current` plus base64-encoded
# 32-byte `<version>.key` files; the service does not generate keys because
# its mount is read-only. Never put a secret value directly in this file.
BROWSER_PROFILE_SERVICE_AUTH_FILE=/etc/veetbot/secrets/browser-profile-service-auth
BROWSER_PROFILE_SESSION_SECRET_FILE=/etc/veetbot/secrets/browser-profile-session-secret
BROWSER_PROFILE_KEY_DIR=/etc/veetbot/secrets/browser-profile-keys

# Bland calling: configure a reviewed public profile and private key before enabling.
# Add call.read,call.cancel,call.delete to AUTH_SCOPES for owner call history controls.
AGENT_CALL_ENABLED=0
AGENT_CALL_INGRESS_ENABLED=0
AGENT_CALL_NOTIFICATIONS_ENABLED=0
BLAND_CONFIGURATION_FILE=
# BLAND_API_KEY_FILE=/etc/veetbot/secrets/bland-api-key
