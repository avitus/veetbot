[Unit]
Description=Veetbot HTTP API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=veetbot
Group=veetbot
WorkingDirectory=/opt/veetbot/current
EnvironmentFile=/etc/veetbot/veetbot.env
EnvironmentFile=-/opt/veetbot/current/.release.env
ExecStart=/opt/veetbot/current/.venv/bin/agent api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/veetbot/artifacts
UMask=0077

[Install]
WantedBy=multi-user.target
