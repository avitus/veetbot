[Unit]
Description=Veetbot maintenance worker
After=network-online.target veetbot-execution.service
Wants=network-online.target
Requires=veetbot-execution.service

[Service]
Type=simple
User=veetbot
Group=veetbot
WorkingDirectory=/opt/veetbot/current
EnvironmentFile=/etc/veetbot/veetbot.env
EnvironmentFile=-/opt/veetbot/current/.release.env
EnvironmentFile=-/opt/veetbot/current/.owner-scopes.env
LoadCredential=browser-control-plane:/etc/veetbot/secrets/browser-control-plane-credential
Environment=BROWSER_PROFILE_CONTROL_PLANE_CREDENTIAL_FILE=%d/browser-control-plane
# The Cockpit GitHub App key (docs/plan/cockpit.md); only this unit commits widgets.
# The whitespace-only default keeps the unit starting until the owner installs the
# key: systemd rejects an empty SetCredential value, and the key loader reads
# whitespace as "empty; install the key".
LoadCredential=cockpit-github-app:/etc/veetbot/secrets/cockpit-github-app.pem
SetCredential=cockpit-github-app:\n
Environment=AGENT_COCKPIT_GITHUB_KEY_FILE=%d/cockpit-github-app
ExecStart=/opt/veetbot/current/.venv/bin/agent worker --role maintenance
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/veetbot/artifacts
# The Scale VP bridge rewrites its rotating grant here (ADR-0153); optional.
ReadWritePaths=-/var/lib/veetbot/svp
UMask=0077

[Install]
WantedBy=multi-user.target
