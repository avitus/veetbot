[Unit]
Description=Veetbot notification dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=veetbot
Group=veetbot
WorkingDirectory=/opt/veetbot/current
EnvironmentFile=/etc/veetbot/veetbot-notify.env
ExecStart=/opt/veetbot/current/.venv/bin/agent worker --role notify
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
