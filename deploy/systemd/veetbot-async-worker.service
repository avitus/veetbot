[Unit]
Description=Veetbot asynchronous durable worker
After=network-online.target veetbot-execution.service
Wants=network-online.target
Requires=veetbot-execution.service

[Service]
Type=simple
User=veetbot
Group=veetbot
WorkingDirectory=/opt/veetbot/current
EnvironmentFile=/etc/veetbot/veetbot.env
EnvironmentFile=-/opt/veetbot/current/.release.env
EnvironmentFile=-/opt/veetbot/current/.owner-scopes.env
LoadCredential=browser-control-plane:/etc/veetbot/secrets/browser-control-plane-credential
Environment=BROWSER_PROFILE_CONTROL_PLANE_CREDENTIAL_FILE=%d/browser-control-plane
ExecStart=/opt/veetbot/current/.venv/bin/agent worker --role async
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/veetbot/artifacts
# The Scale VP bridge rewrites its rotating grant here (ADR-0152); optional.
ReadWritePaths=-/var/lib/veetbot/svp
UMask=0077

[Install]
WantedBy=multi-user.target
