[Unit]
Description=Veetbot signed telephone callback ingress
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=veetbot-call-ingress
Group=veetbot-call-ingress
WorkingDirectory=/opt/veetbot/current
EnvironmentFile=/etc/veetbot/veetbot-call-ingress.env
ExecStart=/opt/veetbot/current/.venv/bin/agent call-ingress
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
