{
  "calls": [
    "http.request",
    "feed.publish"
  ],
  "feeds": [
    "agent.github-pull-requests"
  ],
  "title": "GitHub pull request status snapshot",
  "input_schema": {
    "type": "object",
    "required": [
      "repositories",
      "refresh_seconds"
    ],
    "properties": {
      "repositories": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
        },
        "maxItems": 10,
        "minItems": 1,
        "uniqueItems": true
      },
      "refresh_seconds": {
        "type": "integer",
        "maximum": 86400,
        "minimum": 300
      }
    },
    "additionalProperties": false
  }
}
