{
  "title": "GitHub pull requests",
  "input_schema": {
    "type": "object",
    "properties": {
      "repositories": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}},
      "interval_seconds": {"type": "integer", "minimum": 60, "maximum": 86400}
    },
    "required": ["repositories"],
    "additionalProperties": false
  },
  "calls": ["http.request", "feed.publish"],
  "feeds": ["agent.github-prs"]
}
