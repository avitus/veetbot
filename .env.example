# Required in every deployment.
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
DEPLOYMENT_MODE=development
# Optional deployment identity written by the production release script.
VEETBOT_RELEASE_ID=

# Authentication. Token mode requires AUTH_TOKEN. Production refuses dev mode.
AUTH_MODE=dev
AUTH_TOKEN=
# Required in token mode. Comma-delimited values use exact scope names.
AUTH_TENANT_ID=
AUTH_PRINCIPAL_ID=
AUTH_ROLES=user
AUTH_SCOPES=session.read,session.write,run.read,run.write,run.cancel,approval.read,approval.resolve,artifact.read

# One credential per enabled provider profile. Never put real values here.
# Canonical OpenAI credential. OPENAI_API_KEY remains a compatibility fallback.
VEETBOT_OPENAI_KEY=
ANTHROPIC_API_KEY=

# Optional public-web capabilities. Legacy single-provider selectors remain
# supported. Plural selectors accept provider:percentage entries summing to
# 100; leave them empty to use the legacy selectors. Both capabilities default off.
WEB_SEARCH_PROVIDER=disabled
WEB_FETCH_PROVIDER=disabled
WEB_SEARCH_PROVIDERS=
WEB_FETCH_PROVIDERS=
BROWSER_PROVIDER=disabled
# Exact HTTPS origins only, separated by commas; required for playwright.
BROWSER_ALLOWED_ORIGINS=
BROWSER_PROFILE_SERVICE_URL=
BROWSER_PROFILE_CONTROL_PLANE_CREDENTIAL_FILE=
BROWSER_PROFILE_ID=
BROWSER_GRANT_ID=
BROWSER_RUN_PURPOSE=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
KEENABLE_API_KEY=

# Interpolated only where a checked-in YAML value names ${OPENAI_MODEL}.
OPENAI_MODEL=

# docker and fake are refused when DEPLOYMENT_MODE=production.
SANDBOX_MECHANISM=docker

# Optional overlay directory. Unset means use the committed configuration.
AGENT_CONFIG_DIR=

# Governed trajectory export is disabled unless the operator explicitly enables it.
AGENT_TRAJECTORY_EXPORT_ENABLED=0
AGENT_SCHEDULE_API_ENABLED=0
AGENT_SCHEDULE_WORKER_ENABLED=0

# First-party Gmail MCP servers are absent unless all three private credential
# files exist and email is explicitly enabled. Generate them with
# `python -m gmail_mcp bootstrap`; never place credential JSON in this file.
AGENT_EMAIL_ENABLED=0
GMAIL_READ_CREDENTIAL_FILE=
GMAIL_WRITE_CREDENTIAL_FILE=
GMAIL_SEND_CREDENTIAL_FILE=

# Durable notification API and dispatch are independently default-off. APNs
# credentials are required only when PUSH_PROVIDER=apns; use a private key file.
AGENT_NOTIFICATION_API_ENABLED=0
AGENT_PERSONA_API_ENABLED=0
AGENT_NOTIFICATION_DISPATCH_ENABLED=0
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
PUSH_PROVIDER=disabled

# Milestone 10A skill authoring and its dependent post-run review are both default-off.
AGENT_SKILL_AUTHORING_ENABLED=0
AGENT_SKILL_BACKGROUND_REVIEW_ENABLED=0

# Automatic selection activates only matching operator or release-bundled evidence;
# otherwise formation stays deterministic. Use off to skip model resolution or
# required to refuse startup without an exact model and compiled-policy match.
AGENT_MEMORY_PROVIDER_EXTRACTION_MODE=auto
AGENT_MEMORY_PROVIDER_EXTRACTION_EVIDENCE=
# Optional operator pin: formation@8, formation@9, or formation@10. Empty lets
# automatic selection prefer formation@9, then formation@10, then formation@8.
AGENT_MEMORY_FORMATION_POLICY_PIN=

# Local, content-addressed storage for Milestone 3 trajectory-export artifacts.
AGENT_ARTIFACT_ROOT=.agent/artifacts

# Test-only. 1 enables live-provider tests.
RUN_LIVE_MODEL_TESTS=
