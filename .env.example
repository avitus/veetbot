# Required in every deployment.
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
DEPLOYMENT_MODE=development
# Optional deployment identity written by the production release script.
VEETBOT_RELEASE_ID=

# Authentication. Token mode requires AUTH_TOKEN. Production refuses dev mode.
AUTH_MODE=dev
AUTH_TOKEN=
# Required in token mode. Comma-delimited values use exact scope names.
AUTH_TENANT_ID=
AUTH_PRINCIPAL_ID=
AUTH_ROLES=user
AUTH_SCOPES=session.read,session.write,run.read,run.write,run.cancel,approval.read,approval.resolve,artifact.read

# One credential per enabled provider profile. Never put real values here.
# Canonical OpenAI credential. OPENAI_API_KEY remains a compatibility fallback.
VEETBOT_OPENAI_KEY=
ANTHROPIC_API_KEY=

# Interpolated only where a checked-in YAML value names ${OPENAI_MODEL}.
OPENAI_MODEL=

# docker and fake are refused when DEPLOYMENT_MODE=production.
SANDBOX_MECHANISM=docker

# Optional overlay directory. Unset means use the committed configuration.
AGENT_CONFIG_DIR=

# Governed trajectory export is disabled unless the operator explicitly enables it.
AGENT_TRAJECTORY_EXPORT_ENABLED=0

# Local, content-addressed storage for Milestone 3 trajectory-export artifacts.
AGENT_ARTIFACT_ROOT=.agent/artifacts

# Test-only. 1 enables live-provider tests.
RUN_LIVE_MODEL_TESTS=
